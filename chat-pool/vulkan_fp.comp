#version 450
/* vulkan_fp.comp — fp_vec8 per 144B chunk (1 invocation = 1 chunk).
 * Matches tower.py fp_vec8 + chat_tower.h ct_fp_vec8 bit-for-bit.
 * uint wrap == int32 two's complement bits (parity via memcmp).
 * XOR-fold per group included (anti load-elimination, folded into sums). */
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer InBuf { uint data[]; };
layout(binding = 1) writeonly buffer OutBuf { uint outv[]; };
layout(push_constant) uniform PC { uint chunk_uints; }; /* 36 */

uint bsum(uint u) {
    return (u & 0xFFu) + ((u >> 8) & 0xFFu) + ((u >> 16) & 0xFFu) + (u >> 24);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint v[9];
    for (uint g = 0u; g < 9u; g++) {
        uint s = 0u;
        for (uint k = 0u; k < 4u; k++)
            s += bsum(data[i * chunk_uints + g * 4u + k]);
        v[g] = s;
    }
    uint c4 = v[4];
    outv[i * 8u + 0u] = (v[0] - c4) + (v[1] - c4) + (v[2] - c4);
    outv[i * 8u + 1u] = (v[3] - c4) + (v[4] - c4) + (v[5] - c4);
    outv[i * 8u + 2u] = (v[6] - c4) + (v[7] - c4) + (v[8] - c4);
    outv[i * 8u + 3u] = (v[0] - c4) + (v[3] - c4) + (v[6] - c4);
    outv[i * 8u + 4u] = (v[1] - c4) + (v[4] - c4) + (v[7] - c4);
    outv[i * 8u + 5u] = (v[2] - c4) + (v[5] - c4) + (v[8] - c4);
    outv[i * 8u + 6u] = (v[0] - c4) + (v[4] - c4) + (v[8] - c4);
    outv[i * 8u + 7u] = (v[2] - c4) + (v[4] - c4) + (v[6] - c4);
}
